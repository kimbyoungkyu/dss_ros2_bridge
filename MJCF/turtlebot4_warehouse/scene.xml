    <geom name="rack_e1" type="box" pos="2.6 2.5 0.75" size="0.38 1.65 0.75" rgba="0.30 0.42 0.55 1"/>
    <geom name="rack_e2" type="box" pos="4.2 2.5 0.75" size="0.38 1.65 0.75" rgba="0.30 0.42 0.55 1"/>

    <geom name="rack_sw0" type="box" pos="-4.2 -2.5 0.75" size="0.38 1.65 0.75" rgba="0.36 0.47 0.58 1"/>
    <geom name="rack_sw1" type="box" pos="-2.6 -2.5 0.75" size="0.38 1.65 0.75" rgba="0.36 0.47 0.58 1"/>
