    <geom name="loading_dock" type="box" pos="-4.65 -4.45 0.45" size="0.85 0.35 0.45" rgba="0.65 0.42 0.18 1"/>
    <geom name="pallet_square" type="box" pos="-0.55 -3.30 0.35" size="0.55 0.55 0.35" euler="0 0 0.22" rgba="0.55 0.36 0.18 1"/>
