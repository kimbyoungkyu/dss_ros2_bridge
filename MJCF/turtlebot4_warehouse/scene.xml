<mujoco model="turtlebot4_slam_warehouse">
  <compiler angle="radian"/>
  <option gravity="0 0 -9.81" timestep="0.01"/>
  <include file="turtlebot4.xml"/>
  <worldbody>
    <light pos="0 0 7" dir="0 0 -1" diffuse="0.85 0.85 0.85"/>
