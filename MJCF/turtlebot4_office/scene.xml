<mujoco model="turtlebot4_slam_office_loop">
  <compiler angle="radian"/>
  <option gravity="0 0 -9.81" timestep="0.01"/>
  <include file="turtlebot4.xml"/>
  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="7 6 0.1" rgba="0.82 0.84 0.87 1" friction="1 0.005 0.0001"/>
    <geom name="start_marker" type="cylinder" pos="0 0 0.006" size="0.4 0.005" rgba="0.1 0.7 0.95 0.3" contype="0" conaffinity="0"/>

    <!-- Outer shell: 12 m x 9 m. Walls are 0.1 m thick and 1.5 m high. -->
    <geom name="outer_n" type="box" pos="0 4.55 0.75" size="6.1 0.05 0.75" rgba="0.28 0.31 0.36 1"/>
    <geom name="outer_s" type="box" pos="0 -4.55 0.75" size="6.1 0.05 0.75" rgba="0.28 0.31 0.36 1"/>
    <geom name="outer_e" type="box" pos="6.05 0 0.75" size="0.05 4.6 0.75" rgba="0.28 0.31 0.36 1"/>
    <geom name="outer_w" type="box" pos="-6.05 0 0.75" size="0.05 4.6 0.75" rgba="0.28 0.31 0.36 1"/>

    <!-- Central office core. The robot can complete a loop around it. -->
    <!-- 1.0 m doorway in the north wall lets the robot leave the start room. -->
    <geom name="core_n_w" type="box" pos="-1.525 1.65 0.75" size="1.025 0.05 0.75" rgba="0.42 0.45 0.50 1"/>
    <geom name="core_n_e" type="box" pos="1.525 1.65 0.75" size="1.025 0.05 0.75" rgba="0.42 0.45 0.50 1"/>
    <geom name="core_s" type="box" pos="0 -1.65 0.75" size="2.55 0.05 0.75" rgba="0.42 0.45 0.50 1"/>
    <geom name="core_e" type="box" pos="2.55 0 0.75" size="0.05 1.65 0.75" rgba="0.42 0.45 0.50 1"/>
    <geom name="core_w" type="box" pos="-2.55 0 0.75" size="0.05 1.65 0.75" rgba="0.42 0.45 0.50 1"/>

    <!-- Office partitions with staggered 1 m doors. -->
    <geom name="north_room_w0" type="box" pos="-4.30 2.90 0.75" size="1.70 0.05 0.75" rgba="0.50 0.52 0.56 1"/>
    <geom name="north_room_w1" type="box" pos="-1.55 2.90 0.75" size="0.55 0.05 0.75" rgba="0.50 0.52 0.56 1"/>
    <geom name="north_room_e0" type="box" pos="1.50 3.15 0.75" size="1.50 0.05 0.75" rgba="0.50 0.52 0.56 1"/>
    <geom name="north_room_e1" type="box" pos="4.75 3.15 0.75" size="1.25 0.05 0.75" rgba="0.50 0.52 0.56 1"/>
    <geom name="south_room_w0" type="box" pos="-4.60 -3.05 0.75" size="1.40 0.05 0.75" rgba="0.50 0.52 0.56 1"/>
    <geom name="south_room_w1" type="box" pos="-1.75 -3.05 0.75" size="0.75 0.05 0.75" rgba="0.50 0.52 0.56 1"/>
    <geom name="south_room_e0" type="box" pos="1.55 -2.85 0.75" size="1.55 0.05 0.75" rgba="0.50 0.52 0.56 1"/>
    <geom name="south_room_e1" type="box" pos="4.80 -2.85 0.75" size="1.20 0.05 0.75" rgba="0.50 0.52 0.56 1"/>

    <!-- Distinct landmarks aid scan matching and orientation. -->
    <geom name="round_column" type="cylinder" pos="-4.8 0.4 0.7" size="0.25 0.7" rgba="0.9 0.55 0.15 1"/>
    <geom name="copy_station" type="box" pos="4.75 0.65 0.55" size="0.45 0.7 0.55" rgba="0.25 0.48 0.65 1"/>
    <geom name="desk_nw" type="box" pos="-4.1 3.75 0.38" size="0.8 0.35 0.38" rgba="0.50 0.36 0.23 1"/>
    <geom name="desk_ne" type="box" pos="4.2 3.85 0.38" size="0.65 0.45 0.38" euler="0 0 0.2" rgba="0.50 0.36 0.23 1"/>
    <geom name="meeting_table" type="box" pos="4.0 -3.65 0.38" size="0.9 0.55 0.38" rgba="0.35 0.50 0.42 1"/>
  </worldbody>
</mujoco>
