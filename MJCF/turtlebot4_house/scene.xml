<mujoco model="turtlebot4_slam_apartment">

    <compiler angle="radian"/>
    <option gravity="0 0 -9.81" timestep="0.01"/>

    <!--
        The root body in turtlebot4.xml should start at pos="0 0 ...".
        The origin is a central hallway, giving the robot a safe initial pose.
    -->
    <include file="turtlebot4.xml"/>

    <worldbody>

        <light name="ceiling_light" pos="0 0 5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>

        <!-- 12 m x 10 m floor; apartment interior is 10 m x 8 m. -->
        <geom name="floor" type="plane" size="6 5 0.1"
              rgba="0.82 0.84 0.86 1"
              friction="1.0 0.005 0.0001"/>

        <!-- Robot start marker: visual only. -->
        <geom name="start_marker" type="cylinder"
              pos="0 0 0.006" size="0.45 0.005"
              rgba="0.10 0.65 0.95 0.30"
              contype="0" conaffinity="0"/>

        <!-- ============================================================ -->
        <!-- Outer walls: apartment interior 10 m x 8 m                  -->
        <!-- Wall thickness 0.10 m, height 1.50 m                        -->
        <!-- ============================================================ -->

        <geom name="outer_north" type="box" pos="0 4.05 0.75"
              size="5.10 0.05 0.75" rgba="0.28 0.31 0.36 1"/>
        <geom name="outer_south" type="box" pos="0 -4.05 0.75"
              size="5.10 0.05 0.75" rgba="0.28 0.31 0.36 1"/>
        <geom name="outer_east" type="box" pos="5.05 0 0.75"
              size="0.05 4.10 0.75" rgba="0.28 0.31 0.36 1"/>
        <geom name="outer_west" type="box" pos="-5.05 0 0.75"
              size="0.05 4.10 0.75" rgba="0.28 0.31 0.36 1"/>

        <!-- ============================================================ -->
        <!-- Central hallway boundaries with deliberately staggered doors -->
        <!-- The hallway itself is 1.4 m wide: y = -0.7 .. +0.7          -->
        <!-- ============================================================ -->

        <!-- North hallway wall: three 0.9 m door openings. -->
        <geom name="hall_n_0" type="box" pos="-4.25 0.70 0.75"
              size="0.75 0.05 0.75" rgba="0.40 0.43 0.48 1"/>
        <geom name="hall_n_1" type="box" pos="-1.30 0.70 0.75"
              size="1.30 0.05 0.75" rgba="0.40 0.43 0.48 1"/>
        <geom name="hall_n_2" type="box" pos="1.95 0.70 0.75"
              size="1.05 0.05 0.75" rgba="0.40 0.43 0.48 1"/>
        <geom name="hall_n_3" type="box" pos="4.45 0.70 0.75"
              size="0.55 0.05 0.75" rgba="0.40 0.43 0.48 1"/>

        <!-- South hallway wall: door positions differ to avoid symmetry. -->
        <geom name="hall_s_0" type="box" pos="-4.50 -0.70 0.75"
              size="0.50 0.05 0.75" rgba="0.40 0.43 0.48 1"/>
        <geom name="hall_s_1" type="box" pos="-2.05 -0.70 0.75"
              size="1.05 0.05 0.75" rgba="0.40 0.43 0.48 1"/>
        <geom name="hall_s_2" type="box" pos="0.70 -0.70 0.75"
              size="0.80 0.05 0.75" rgba="0.40 0.43 0.48 1"/>
        <geom name="hall_s_3" type="box" pos="3.70 -0.70 0.75"
              size="1.30 0.05 0.75" rgba="0.40 0.43 0.48 1"/>

        <!-- ============================================================ -->
        <!-- North rooms: bedroom, bathroom/study, kitchen               -->
        <!-- ============================================================ -->

        <geom name="north_partition_w" type="box" pos="-2.60 2.375 0.75"
              size="0.05 1.625 0.75" rgba="0.40 0.43 0.48 1"/>
        <geom name="north_partition_e" type="box" pos="3.00 2.375 0.75"
              size="0.05 1.625 0.75" rgba="0.40 0.43 0.48 1"/>

        <!-- Small asymmetric bathroom inside the north-middle room. -->
        <geom name="bath_wall_h" type="box" pos="-0.55 2.55 0.75"
              size="1.05 0.05 0.75" rgba="0.48 0.52 0.57 1"/>
        <geom name="bath_wall_v" type="box" pos="0.50 3.30 0.75"
              size="0.05 0.75 0.75" rgba="0.48 0.52 0.57 1"/>

        <!-- ============================================================ -->
        <!-- South rooms: second bedroom, utility room, living room      -->
        <!-- ============================================================ -->

        <geom name="south_partition_w" type="box" pos="-3.00 -2.375 0.75"
              size="0.05 1.625 0.75" rgba="0.40 0.43 0.48 1"/>
        <geom name="south_partition_e" type="box" pos="1.50 -2.375 0.75"
              size="0.05 1.625 0.75" rgba="0.40 0.43 0.48 1"/>

        <!-- Short L-shaped utility-room wall creates a distinctive corner. -->
        <geom name="utility_wall_h" type="box" pos="-0.15 -2.55 0.75"
              size="0.85 0.05 0.75" rgba="0.48 0.52 0.57 1"/>
        <geom name="utility_wall_v" type="box" pos="-1.00 -3.30 0.75"
              size="0.05 0.75 0.75" rgba="0.48 0.52 0.57 1"/>

        <!-- ============================================================ -->
        <!-- Static furniture / LiDAR landmarks                          -->
        <!-- All objects are tall enough to intersect the 2D LiDAR plane. -->
        <!-- ============================================================ -->

        <!-- North-west bedroom -->
        <geom name="bed_nw" type="box" pos="-3.85 2.75 0.30"
              size="0.85 0.60 0.30" rgba="0.48 0.30 0.30 1"/>
        <geom name="wardrobe_nw" type="box" pos="-4.65 1.35 0.65"
              size="0.25 0.55 0.65" rgba="0.36 0.29 0.22 1"/>

        <!-- North-middle dining / study area -->
        <geom name="dining_table" type="box" pos="1.65 2.20 0.38"
              size="0.65 0.45 0.38" rgba="0.50 0.38 0.24 1"/>
        <geom name="column_round" type="cylinder" pos="2.35 3.30 0.75"
              size="0.22 0.75" rgba="0.55 0.58 0.62 1"/>

        <!-- North-east kitchen counters: L-shaped landmark -->
        <geom name="kitchen_counter_n" type="box" pos="4.00 3.65 0.45"
              size="0.90 0.25 0.45" rgba="0.30 0.48 0.42 1"/>
        <geom name="kitchen_counter_e" type="box" pos="4.65 2.75 0.45"
              size="0.25 0.90 0.45" rgba="0.30 0.48 0.42 1"/>

        <!-- South-west bedroom -->
        <geom name="bed_sw" type="box" pos="-4.05 -2.65 0.30"
              size="0.65 0.90 0.30" rgba="0.42 0.32 0.48 1"/>

        <!-- South-east living room: rotated sofa and low table -->
        <geom name="sofa" type="box" pos="3.55 -2.85 0.38"
              size="1.00 0.38 0.38" euler="0 0 0.18"
              rgba="0.24 0.43 0.58 1"/>
        <geom name="coffee_table" type="box" pos="2.70 -1.65 0.28"
              size="0.55 0.38 0.28" rgba="0.52 0.39 0.25 1"/>

        <!-- Hallway landmark prevents a feature-poor long straight scan. -->
        <geom name="hallway_pillar" type="cylinder" pos="4.45 0 0.55"
              size="0.18 0.55" rgba="0.85 0.55 0.18 1"/>

    </worldbody>

</mujoco>
